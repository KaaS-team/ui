{{/* approval: a decision a person approves or rejects, pinned to a commit. Data: ui.Approval. */}}
{{define "approval"}}<section class="ui-approval">
<h3 class="ui-approval-title">{{.Title}}</h3>
{{with .Summary}}<p class="ui-approval-summary">{{.}}</p>{{end}}
{{if or .SHA .DiffURL}}<p class="ui-approval-meta">{{with .SHA}}Commit <code>{{.}}</code>{{end}}{{if and .SHA .DiffURL}} · {{end}}{{with .DiffURL}}<a href="{{.}}">View diff</a>{{end}}</p>{{end}}
{{if .Decided}}<p class="ui-approval-decided" role="status">{{.Decided}}</p>
{{else}}<div class="ui-approval-actions">
<form method="post" action="{{.ApproveURL}}">{{with .CSRF}}<input type="hidden" name="csrf" value="{{.}}">{{end}}{{with .SHA}}<input type="hidden" name="sha" value="{{.}}">{{end}}<button class="ui-button" type="submit" data-variant="primary">Approve</button></form>
<form method="post" action="{{.RejectURL}}">{{with .CSRF}}<input type="hidden" name="csrf" value="{{.}}">{{end}}{{with .SHA}}<input type="hidden" name="sha" value="{{.}}">{{end}}<button class="ui-button" type="submit" data-variant="danger">Reject</button></form>
</div>{{end}}
</section>{{end}}
