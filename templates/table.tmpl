{{/* table: a data table, or its empty state when there are no rows. Data: ui.Table. */}}
{{define "table"}}{{if .Rows}}<table class="ui-table">
{{with .Caption}}<caption>{{.}}</caption>{{end}}
<thead><tr>{{range .Columns}}<th scope="col">{{.}}</th>{{end}}</tr></thead>
<tbody>
{{range .Rows}}<tr>{{range .}}<td>{{.}}</td>{{end}}</tr>
{{end}}</tbody>
</table>{{else}}{{template "empty" .Empty}}{{end}}{{end}}
