{{/* button: a link when Href is set, otherwise a <button>. A disabled link becomes a disabled button. Data: ui.Button. */}}
{{define "button"}}{{if and .Href (not .Disabled)}}<a class="ui-button" href="{{.Href}}"{{with .Variant}} data-variant="{{.}}"{{end}}>{{.Label}}</a>{{else}}<button class="ui-button" type="{{or .Type "button"}}"{{with .Variant}} data-variant="{{.}}"{{end}}{{with .Name}} name="{{.}}"{{end}}{{with .Value}} value="{{.}}"{{end}}{{if .Disabled}} disabled{{end}}>{{.Label}}</button>{{end}}{{end}}
