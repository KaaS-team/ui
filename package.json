  "scripts": {
    "test": "node --test test/*.test.mjs",
    "axe": "node catalogue/axe.mjs",
    "screens": "node catalogue/screens.mjs"
  },
  "style": "./css/ui.css",
  "sideEffects": [
    "*.css"
  ],
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=22"
