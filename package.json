{
  "name": "@kaas-team/ui",
  "version": "0.1.0",
  "description": "KaaS design system: tokens and CSS layers.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "files": [
    "css",
    "tokens.json"
  ],
  "exports": {
    ".": "./css/ui.css",
    "./ui.css": "./css/ui.css",
    "./tokens.css": "./css/tokens.css",
    "./css/*": "./css/*",
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json"
