{
  "$comment": "Every --ui-* token name, by group. test/tokens.test.mjs fails unless css/tokens.css declares exactly these names, and every group with dark: true is redefined under prefers-color-scheme: dark. U2 extends the parity to Go.",
  "groups": {
    "colour": {
      "dark": true,
      "names": ["--ui-bg", "--ui-surface", "--ui-raised", "--ui-border", "--ui-text", "--ui-muted", "--ui-accent", "--ui-on-accent", "--ui-focus"]
    },
    "status": {
      "dark": true,
      "names": ["--ui-pass", "--ui-pass-bg", "--ui-wait", "--ui-wait-bg", "--ui-fail", "--ui-fail-bg", "--ui-info", "--ui-info-bg"]
    },
    "space": {
      "dark": false,
      "names": ["--ui-space-1", "--ui-space-2", "--ui-space-3", "--ui-space-4", "--ui-space-5", "--ui-space-6", "--ui-space-7", "--ui-space-8"]
    },
    "radius": {
      "dark": false,
      "names": ["--ui-radius-sm", "--ui-radius-md", "--ui-radius-lg", "--ui-radius-pill"]
    },
    "type": {
      "dark": false,
      "names": ["--ui-type-xs", "--ui-type-sm", "--ui-type-md", "--ui-type-lg", "--ui-type-xl", "--ui-type-2xl", "--ui-leading"]
    },
    "font": {
      "dark": false,
      "names": ["--ui-font-sans", "--ui-font-mono"]
    },
    "shadow": {
      "dark": true,
      "names": ["--ui-shadow-sm", "--ui-shadow-md", "--ui-ring"]
    },
    "motion": {
      "dark": false,
      "names": ["--ui-ease", "--ui-dur-quick", "--ui-dur-gentle"]
    }
  }
}
